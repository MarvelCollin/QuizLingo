{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "regions": [
    "hnd1"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/quizlingo/",
      "permanent": false
    },
    {
      "source": "/quizlingo",
      "destination": "/quizlingo/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/quizlingo/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/quizlingo/login",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/register",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/basics",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/basics/:lessonId",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/round",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/words",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/words/:word",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/characters",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/characters/:char",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/characters",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/writing",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/sounds",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/tones",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/pinyin",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/grammar",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/grammar/:level",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/tests",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/tests/:path*",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/practice/speaking",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/tests/listening/:id",
      "destination": "/quizlingo/index.html"
    },
    {
      "source": "/quizlingo/tests/mock/:level",
      "destination": "/quizlingo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/quizlingo/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/quizlingo/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/quizlingo/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
